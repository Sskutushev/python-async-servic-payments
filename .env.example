# Copy to .env for local runs. Values below are DEMO ONLY — generate real secrets for anything shared.
APP_ENV=dev
LOG_LEVEL=INFO

# At least 16 characters. Compared in constant time against X-API-Key.
API_KEY=demo-api-key-change-me-please
# HMAC-SHA256 key for X-Webhook-Signature.
WEBHOOK_SECRET=demo-webhook-secret-change-me

DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

# Webhook target policy (SSRF boundary). In prod both flags must be false.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
WEBHOOK_ALLOW_INSECURE_HTTP=true

# Simulated gateway: 2–5 s latency, 90 % success, deterministic per payment_id.
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

# Retry budget: 3 attempts total, delays 1 s then 2 s.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
